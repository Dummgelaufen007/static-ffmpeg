ARG IMAGE=static-ffmpeg-fdk

FROM $IMAGE AS ffmpeg

FROM alpine:3.20.3 AS packager

RUN apk add --no-cache tar xz

COPY --from=ffmpeg / /data

ARG CACHE_BUST
ARG VARIANT=
ARG TARGETARCH

RUN NAME="ffmpeg-${TARGETARCH}-${VARIANT:+$VARIANT-}${CACHE_BUST}" && \
    mv /data "/${NAME}" && \
    tar -I "xz -T0" \
        -cf "/${NAME}.tar.xz" \
        -C / \
        "${NAME}"

FROM scratch AS export

COPY --from=packager /ffmpeg-*.tar.xz /
