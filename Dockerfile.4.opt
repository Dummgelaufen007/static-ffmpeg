# bump: alpine /ALPINE_VERSION=alpine:([\d.]+)/ docker:alpine|^3
# bump: alpine link "Release notes" https://alpinelinux.org/posts/Alpine-$LATEST-released.html
ARG ALPINE_VERSION=alpine:3.24.2
FROM $ALPINE_VERSION AS alpine
# over http, so a caching proxy passed as http_proxy can store the packages
RUN [ -z "$http_proxy" ] || sed -i 's|^https:|http:|' /etc/apk/repositories

FROM scratch AS downloads

FROM alpine AS downloader
ARG APK_OPTS=""
RUN apk add --no-cache $APK_OPTS bash wget git
COPY --from=downloads / /downloads/
ARG DOCKERFILE=Dockerfile
ARG ENABLE_FDKAAC=
ARG OPTIONAL_DOWNLOADS="FDK_AAC=ENABLE_FDKAAC"
RUN --mount=src=$DOCKERFILE,dst=/Dockerfile bash -euo pipefail <<'DOWNLOADER'
skip=()
for pair in $OPTIONAL_DOWNLOADS; do
  switch=${pair#*=}
  [[ -n ${!switch} ]] || skip+=("${pair%%=*}")
done
sed -E "/^ARG ($(IFS='|'; echo "${skip[*]}"))_(URL|FILE)=/d" /Dockerfile > /Dockerfile.downloads
fetch_file() {
  local url=$1 file=$2 sha=$3
  if ! echo "$sha  $file" | sha256sum -c - >/dev/null 2>&1; then
    wget -O "$file" $WGET_OPTS "$url"
    echo "$sha  $file" | sha256sum -c -
  fi
}
git_clone() {
  local url=$1 commit=$2 dir=$3 changes
  if ! [[ $commit =~ ^[0-9a-f]{40}$ ]]; then
    echo "not a commit for $url: $commit" >&2
    exit 1
  fi
  # explicit git dir: git -C falls back to a parent repo when .git is broken
  local repo_git=(git --git-dir="$dir/.git" --work-tree="$dir")
  if ! { [[ $("${repo_git[@]}" rev-parse HEAD 2>/dev/null) == "$commit" ]] && "${repo_git[@]}" read-tree HEAD 2>/dev/null \
      && changes=$("${repo_git[@]}" status --porcelain --untracked-files=all 2>/dev/null) && [[ -z $changes ]]; }; then
    rm -rf "$dir"
    git clone --filter=tree:0 --no-checkout "$url" "$dir"
    git -C "$dir" -c advice.detachedHead=false checkout --recurse-submodules "$commit"
  fi
}
eval "$(sed -n 's/^ARG \([A-Za-z_][A-Za-z0-9_]*=\)/\1/p' /Dockerfile.downloads)"
cd /downloads
for prefix in $(sed -n 's/^ARG \([A-Za-z0-9_]*\)_URL=.*/\1/p' /Dockerfile.downloads); do
  file_var=${prefix}_FILE url_var=${prefix}_URL sha_var=${prefix}_SHA256
  commit_var=${prefix}_COMMIT dir_var=${prefix}_DIR
  if [[ -n ${!file_var:-} ]]; then
    fetch_file "${!url_var}" "${!file_var}" "${!sha_var}"
  else
    git_clone "${!url_var}" "${!commit_var:-}" "${!dir_var}"
  fi
done
DOWNLOADER

FROM alpine AS builder

# Alpine Package Keeper options
ARG APK_OPTS=""

RUN apk add --no-cache $APK_OPTS \
  coreutils \
  pkgconfig \
  wget \
  rust cargo cargo-c \
  ca-certificates \
  bash \
  tar \
  build-base \
  autoconf automake \
  libtool \
  diffutils \
  cmake meson ninja \
  git \
  yasm nasm \
  jq \
  xxd \
  xz \
  gperf \
  gettext-tiny \
  python3 py3-packaging \
  linux-headers \
  musl-libintl

# linux-headers need by rtmpdump
# python3 py3-packaging needed by glib
# musl-libintl replaces the proxy-libintl download of glib
# xz unpacks the .tar.xz sources, gperf is needed by fontconfig, gettext-tiny by the autoreconf of xz

COPY --from=downloader /downloads/ /

# -O3 makes sure we compile with optimization. setting CFLAGS/CXXFLAGS seems to override
# default automake cflags.
# -static-libgcc is needed to make gcc not include gcc_s as "as-needed" shared library which
# cmake will include as a implicit library.
# other options to get hardened build (same as ffmpeg hardened)
ARG LTO_FLAGS="-flto=auto"
ARG CFLAGS="-O3 -static-libgcc -fno-strict-overflow -fstack-protector-all -fPIC $LTO_FLAGS"
ARG CXXFLAGS="-O3 -static-libgcc -fno-strict-overflow -fstack-protector-all -fPIC $LTO_FLAGS"
ARG LDFLAGS="-Wl,-z,relro,-z,now"

# retry dns and some http codes that might be transient errors
ARG WGET_OPTS="--tries=10 --connect-timeout=10 --retry-connrefused --retry-on-host-error --retry-on-http-error=429,500,502,503,504"

# --no-same-owner as we don't care about uid/gid even if we run as root. fixes invalid gid/uid issue.
ARG TAR_OPTS="--no-same-owner --extract --file"

# the libraries alpine shipped before, at the versions and with the patches of alpine 3.24
ARG APORTS_RAW="https://gitlab.alpinelinux.org/alpine/aports/-/raw/f688430cdb9bdbb3a77130f659201fac2ef92a3e/main"

# bump: zlib /ZLIB_VERSION=([\d.]+)/ https://github.com/madler/zlib.git|^1
# bump: zlib after ./hashupdate Dockerfile ZLIB $LATEST
# bump: zlib link "ChangeLog" https://github.com/madler/zlib/blob/develop/ChangeLog
ARG ZLIB_VERSION=1.3.2
ARG ZLIB_URL="https://zlib.net/fossils/zlib-$ZLIB_VERSION.tar.gz"
ARG ZLIB_FILE="zlib.$ZLIB_VERSION.tar.gz"
ARG ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
ARG ZLIB_CVE_2026_85091_URL="$APORTS_RAW/zlib/CVE-2026-85091.patch"
ARG ZLIB_CVE_2026_85091_FILE="zlib.CVE-2026-85091.patch"
ARG ZLIB_CVE_2026_85091_SHA256=110ff14375733173d8aa54574473424fbd7dfe4b81f1ca34a759c6fe14b15b14
RUN \
  tar $TAR_OPTS $ZLIB_FILE && \
  cd zlib-* && \
  patch -p1 < ../$ZLIB_CVE_2026_85091_FILE && \
  ./configure --static && \
  make -j$(nproc) install

# bump: bzip2 /BZIP2_VERSION=([\d.]+)/ fetch:https://sourceware.org/pub/bzip2/|/bzip2-([\d.]+)\.tar\.gz/
# bump: bzip2 after ./hashupdate Dockerfile BZIP2 $LATEST
# bump: bzip2 link "CHANGES" https://sourceware.org/git/?p=bzip2.git;a=blob;f=CHANGES
ARG BZIP2_VERSION=1.0.8
ARG BZIP2_URL="https://sourceware.org/pub/bzip2/bzip2-$BZIP2_VERSION.tar.gz"
ARG BZIP2_FILE="bzip2.$BZIP2_VERSION.tar.gz"
ARG BZIP2_SHA256=ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269
ARG BZIP2_MAKEFILE_CFLAGS_URL="$APORTS_RAW/bzip2/bzip2-1.0.4-makefile-CFLAGS.patch"
ARG BZIP2_MAKEFILE_CFLAGS_FILE="bzip2.makefile-CFLAGS.patch"
ARG BZIP2_MAKEFILE_CFLAGS_SHA256=f8cc63dcebef734154cc36c3ef963158ff2be6fc2d183cff49b627d570336628
ARG BZIP2_MAN_LINKS_URL="$APORTS_RAW/bzip2/bzip2-1.0.4-man-links.patch"
ARG BZIP2_MAN_LINKS_FILE="bzip2.man-links.patch"
ARG BZIP2_MAN_LINKS_SHA256=1fc9d91f3f7bd3eecd86149b9c95b3162d9d7956f7de543aa8bc41cbcd04f88b
ARG BZIP2_PROGRESS_URL="$APORTS_RAW/bzip2/bzip2-1.0.2-progress.patch"
ARG BZIP2_PROGRESS_FILE="bzip2.progress.patch"
ARG BZIP2_PROGRESS_SHA256=a76f6d082a1a1fef2eff111177d7c7568e1d457fb2b98cde71bbbe6ea1c7c787
ARG BZIP2_NO_TEST_URL="$APORTS_RAW/bzip2/bzip2-1.0.3-no-test.patch"
ARG BZIP2_NO_TEST_FILE="bzip2.no-test.patch"
ARG BZIP2_NO_TEST_SHA256=3478e797662d85996c03d3b7612d548d2d377fe7efc3dc190332741a11082ef6
ARG BZIP2_SANESO_URL="$APORTS_RAW/bzip2/saneso.patch"
ARG BZIP2_SANESO_FILE="bzip2.saneso.patch"
ARG BZIP2_SANESO_SHA256=0d6e3221c3db90ccbaec2c3c44afdfdd055093f4650a4e2f1a9b97cf48b69671
ARG BZIP2_PC_URL="$APORTS_RAW/bzip2/bzip2.pc.in"
ARG BZIP2_PC_FILE="bzip2.pc.in"
ARG BZIP2_PC_SHA256=eca9d8cd6376df1fb5442667c603032023fb21d8d183684550da0b96ade39654
RUN \
  tar $TAR_OPTS $BZIP2_FILE && \
  cd bzip2-* && \
  for p in $BZIP2_MAKEFILE_CFLAGS_FILE $BZIP2_MAN_LINKS_FILE $BZIP2_PROGRESS_FILE $BZIP2_NO_TEST_FILE $BZIP2_SANESO_FILE; do patch -p1 < ../$p || exit 1; done && \
  # on the command line CFLAGS replaces the -O2 that the makefile patch appends
  make -j$(nproc) libbz2.a CFLAGS="$CFLAGS -D_FILE_OFFSET_BITS=64" && \
  install -D -m644 libbz2.a /usr/local/lib/libbz2.a && \
  install -D -m644 bzlib.h /usr/local/include/bzlib.h && \
  mkdir -p /usr/local/lib/pkgconfig && \
  sed -e "s|@VERSION@|$BZIP2_VERSION|" -e 's|^prefix=/usr$|prefix=/usr/local|' -e 's|^exec_prefix=/usr$|exec_prefix=${prefix}|' \
    ../$BZIP2_PC_FILE > /usr/local/lib/pkgconfig/bzip2.pc

# bump: xz /XZ_VERSION=([\d.]+)/ https://github.com/tukaani-project/xz.git|^5
# bump: xz after ./hashupdate Dockerfile XZ $LATEST
# bump: xz link "NEWS" https://github.com/tukaani-project/xz/blob/master/NEWS
ARG XZ_VERSION=5.8.4
ARG XZ_URL="https://github.com/tukaani-project/xz/archive/refs/tags/v$XZ_VERSION/xz-$XZ_VERSION.tar.gz"
ARG XZ_FILE="xz.$XZ_VERSION.tar.gz"
ARG XZ_SHA256=b6b34c52e672e810d339db14e0c10b5b6f5f67a30d8d05cdac5d8cb4d82f78d5
RUN \
  tar $TAR_OPTS $XZ_FILE && \
  cd xz-* && \
  autoreconf -fi && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static \
    --disable-doc \
    --disable-nls \
    --disable-xz \
    --disable-xzdec \
    --disable-lzmadec \
    --disable-lzmainfo \
    --disable-lzma-links \
    --disable-scripts && \
  make -j$(nproc) install

# bump: libpng /LIBPNG_VERSION=([\d.]+)/ https://github.com/pnggroup/libpng.git|^1
# bump: libpng after ./hashupdate Dockerfile LIBPNG $LATEST
# bump: libpng link "CHANGES" https://github.com/pnggroup/libpng/blob/libpng16/CHANGES
ARG LIBPNG_VERSION=1.6.59
ARG LIBPNG_URL="https://github.com/pnggroup/libpng/archive/refs/tags/v$LIBPNG_VERSION.tar.gz"
ARG LIBPNG_FILE="libpng.$LIBPNG_VERSION.tar.gz"
ARG LIBPNG_SHA256=2540302a1844ad2b2b501977abecfa850f265f97b78f065a712ab4074a89f5b5
ARG LIBPNG_APNG_URL="https://downloads.sourceforge.net/sourceforge/libpng-apng/libpng-1.6.58-apng.patch.gz"
ARG LIBPNG_APNG_FILE="libpng.apng.patch.gz"
ARG LIBPNG_APNG_SHA256=eee7dea22ed502868017971c86c63c4ed1e6085de0baebfdcc3d3322f00f3eb0
ARG LIBPNG_ARM_NEON_URL="$APORTS_RAW/libpng/libpng-fix-arm-neon.patch"
ARG LIBPNG_ARM_NEON_FILE="libpng.fix-arm-neon.patch"
ARG LIBPNG_ARM_NEON_SHA256=7a9ba0b862155cda2089fd7306eb2a7b75ca083afa51201cc5bf49ee2039a65a
RUN \
  tar $TAR_OPTS $LIBPNG_FILE && \
  cd libpng-* && \
  gunzip -c ../$LIBPNG_APNG_FILE | patch -p1 && \
  patch -p1 < ../$LIBPNG_ARM_NEON_FILE && \
  autoreconf -fi && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static && \
  make -j$(nproc) install

# bump: brotli /BROTLI_VERSION=([\d.]+)/ https://github.com/google/brotli.git|^1
# bump: brotli after ./hashupdate Dockerfile BROTLI $LATEST
# bump: brotli link "Release notes" https://github.com/google/brotli/releases/tag/v$LATEST
ARG BROTLI_VERSION=1.2.0
ARG BROTLI_URL="https://github.com/google/brotli/archive/refs/tags/v$BROTLI_VERSION.tar.gz"
ARG BROTLI_FILE="brotli.$BROTLI_VERSION.tar.gz"
ARG BROTLI_SHA256=816c96e8e8f193b40151dad7e8ff37b1221d019dbcb9c35cd3fadbfe6477dfec
ARG BROTLI_OPTIMIZE_MIPS_URL="$APORTS_RAW/brotli/optimize-mips.patch"
ARG BROTLI_OPTIMIZE_MIPS_FILE="brotli.optimize-mips.patch"
ARG BROTLI_OPTIMIZE_MIPS_SHA256=b30d0c6164132d2e7d76f0229e941f51660816af3af1f0edd47640f1f74a7f53
ARG BROTLI_FIX_LP64_URL="$APORTS_RAW/brotli/fix-lp64.patch"
ARG BROTLI_FIX_LP64_FILE="brotli.fix-lp64.patch"
ARG BROTLI_FIX_LP64_SHA256=5e8d058bc4a37b06f36004e9b0d890978059f598abd6855dbce9a82a61617857
RUN \
  tar $TAR_OPTS $BROTLI_FILE && \
  cd brotli-* && \
  for p in $BROTLI_OPTIMIZE_MIPS_FILE $BROTLI_FIX_LP64_FILE; do patch -p1 < ../$p || exit 1; done && \
  cmake -B build \
    -G"Unix Makefiles" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DBROTLI_DISABLE_TESTS=ON && \
  make -C build -j$(nproc) install

# bump: freetype /FREETYPE_VERSION=([\d.]+)/ fetch:https://download.savannah.gnu.org/releases/freetype/|/freetype-([\d.]+)\.tar\.xz/
# bump: freetype after ./hashupdate Dockerfile FREETYPE $LATEST
# bump: freetype link "CHANGES" https://gitlab.freedesktop.org/freetype/freetype/-/blob/master/docs/CHANGES
ARG FREETYPE_VERSION=2.14.3
ARG FREETYPE_URL="https://download.savannah.gnu.org/releases/freetype/freetype-$FREETYPE_VERSION.tar.xz"
ARG FREETYPE_FILE="freetype.$FREETYPE_VERSION.tar.xz"
ARG FREETYPE_SHA256=36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f
ARG FREETYPE_PCF_FAMILY_NAMES_URL="$APORTS_RAW/freetype/pcf-family-names.patch"
ARG FREETYPE_PCF_FAMILY_NAMES_FILE="freetype.pcf-family-names.patch"
ARG FREETYPE_PCF_FAMILY_NAMES_SHA256=5fc0fa5b1ea27721df648e3b1510b89f749f3a8a381c83a4324471efa46be0a1
ARG FREETYPE_SUBPIXEL_URL="$APORTS_RAW/freetype/subpixel.patch"
ARG FREETYPE_SUBPIXEL_FILE="freetype.subpixel.patch"
ARG FREETYPE_SUBPIXEL_SHA256=2842df91ec228e40e34ffaea5f60137a311106e1e1a125a5af67fcf530eeb5e0
ARG FREETYPE_TABLE_VALIDATION_URL="$APORTS_RAW/freetype/table-validation-modules.patch"
ARG FREETYPE_TABLE_VALIDATION_FILE="freetype.table-validation-modules.patch"
ARG FREETYPE_TABLE_VALIDATION_SHA256=90a6a88e59ad8dabfe8e66145e77d6a7c648b0c3439ac341766e3667d144f33f
RUN \
  tar $TAR_OPTS $FREETYPE_FILE && \
  cd freetype-* && \
  for p in $FREETYPE_PCF_FAMILY_NAMES_FILE $FREETYPE_SUBPIXEL_FILE $FREETYPE_TABLE_VALIDATION_FILE; do patch -p1 < ../$p || exit 1; done && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dharfbuzz=disabled \
    -Dtests=disabled && \
  ninja -j$(nproc) -vC build install

# bump: expat /EXPAT_VERSION=([\d.]+)/ https://github.com/libexpat/libexpat.git|/^R_\d+_\d+_\d+$/|re:#^R_(\d+)_(\d+)_(\d+)$#${1}.${2}.${3}#|*
# bump: expat after sed -i -E "s#/R_[0-9_]+/#/R_$(echo $LATEST | tr . _)/#" Dockerfile && ./hashupdate Dockerfile EXPAT $LATEST
# bump: expat link "Changes" https://github.com/libexpat/libexpat/blob/master/expat/Changes
ARG EXPAT_VERSION=2.8.5
ARG EXPAT_URL="https://github.com/libexpat/libexpat/releases/download/R_2_8_5/expat-$EXPAT_VERSION.tar.xz"
ARG EXPAT_FILE="expat.$EXPAT_VERSION.tar.xz"
ARG EXPAT_SHA256=1e727b8933ec51a77a9a9d9afcf8e688bce45d907c13e36ab7393fe36e703182
RUN \
  tar $TAR_OPTS $EXPAT_FILE && \
  cd expat-* && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static \
    --without-docbook \
    --without-xmlwf \
    --without-examples \
    --without-tests && \
  make -j$(nproc) install

# config and cache paths of the alpine package, whose config and cache the fonts installed at the end bring
# bump: fontconfig /FONTCONFIG_VERSION=([\d.]+)/ https://gitlab.freedesktop.org/fontconfig/fontconfig.git|^2
# bump: fontconfig after ./hashupdate Dockerfile FONTCONFIG $LATEST
# bump: fontconfig link "NEWS" https://gitlab.freedesktop.org/fontconfig/fontconfig/-/blob/main/NEWS
ARG FONTCONFIG_VERSION=2.17.1
ARG FONTCONFIG_URL="https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/$FONTCONFIG_VERSION/fontconfig-$FONTCONFIG_VERSION.tar.xz"
ARG FONTCONFIG_FILE="fontconfig.$FONTCONFIG_VERSION.tar.xz"
ARG FONTCONFIG_SHA256=9f5cae93f4fffc1fbc05ae99cdfc708cd60dfd6612ffc0512827025c026fa541
ARG FONTCONFIG_FIX_ARITHMETIC_URL="$APORTS_RAW/fontconfig/fix-arithmetic.patch"
ARG FONTCONFIG_FIX_ARITHMETIC_FILE="fontconfig.fix-arithmetic.patch"
ARG FONTCONFIG_FIX_ARITHMETIC_SHA256=8c8d09c69e6b53519c1ee0a24afe682e84ed838c6aa446c30fa0a89cb1450e12
RUN \
  tar $TAR_OPTS $FONTCONFIG_FILE && \
  cd fontconfig-* && \
  patch -p1 < ../$FONTCONFIG_FIX_ARITHMETIC_FILE && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-docs \
    --disable-nls && \
  make -j$(nproc) -C src && \
  make -C src install && \
  make -C fontconfig install && \
  make install-pkgconfigDATA

# bump: fribidi /FRIBIDI_VERSION=([\d.]+)/ https://github.com/fribidi/fribidi.git|^1
# bump: fribidi after ./hashupdate Dockerfile FRIBIDI $LATEST
# bump: fribidi link "NEWS" https://github.com/fribidi/fribidi/blob/master/NEWS
ARG FRIBIDI_VERSION=1.0.16
ARG FRIBIDI_URL="https://github.com/fribidi/fribidi/releases/download/v$FRIBIDI_VERSION/fribidi-$FRIBIDI_VERSION.tar.xz"
ARG FRIBIDI_FILE="fribidi.$FRIBIDI_VERSION.tar.xz"
ARG FRIBIDI_SHA256=1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c
RUN \
  tar $TAR_OPTS $FRIBIDI_FILE && \
  cd fribidi-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Ddocs=false \
    -Dbin=false \
    -Dtests=false && \
  ninja -j$(nproc) -vC build install

# bump: libxml2 /LIBXML2_VERSION=([\d.]+)/ https://gitlab.gnome.org/GNOME/libxml2.git|^2
# bump: libxml2 after ./hashupdate Dockerfile LIBXML2 $LATEST
# bump: libxml2 link "NEWS" https://gitlab.gnome.org/GNOME/libxml2/-/blob/master/NEWS
ARG LIBXML2_VERSION=2.13.9
ARG LIBXML2_URL="https://download.gnome.org/sources/libxml2/2.13/libxml2-$LIBXML2_VERSION.tar.xz"
ARG LIBXML2_FILE="libxml2.$LIBXML2_VERSION.tar.xz"
ARG LIBXML2_SHA256=a2c9ae7b770da34860050c309f903221c67830c86e4a7e760692b803df95143a
ARG LIBXML2_CVE_2026_6732_URL="$APORTS_RAW/libxml2/CVE-2026-6732.patch"
ARG LIBXML2_CVE_2026_6732_FILE="libxml2.CVE-2026-6732.patch"
ARG LIBXML2_CVE_2026_6732_SHA256=42d45b35f36bf29229e39a9e5349d7347e51d92099573b5a509f448dbf0e34d7
ARG LIBXML2_CVE_2026_6732_TEST_URL="$APORTS_RAW/libxml2/CVE-2026-6732-test.patch"
ARG LIBXML2_CVE_2026_6732_TEST_FILE="libxml2.CVE-2026-6732-test.patch"
ARG LIBXML2_CVE_2026_6732_TEST_SHA256=7c93e102dfdeaaf5d7adeda70c0dec6bfc492dbe9a14a29d42512a6c3f39a6c2
RUN \
  tar $TAR_OPTS $LIBXML2_FILE && \
  cd libxml2-* && \
  for p in $LIBXML2_CVE_2026_6732_FILE $LIBXML2_CVE_2026_6732_TEST_FILE; do patch -p1 < ../$p || exit 1; done && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static \
    --with-legacy \
    --with-lzma \
    --with-zlib \
    --without-python && \
  make -j$(nproc) install

# bump: pcre2 /PCRE2_VERSION=([\d.]+)/ https://github.com/PCRE2Project/pcre2.git|/^pcre2-\d+\.\d+$/|re:#^pcre2-(\d+\.\d+)$#${1}#|*
# bump: pcre2 after ./hashupdate Dockerfile PCRE2 $LATEST
# bump: pcre2 link "ChangeLog" https://github.com/PCRE2Project/pcre2/blob/master/ChangeLog
ARG PCRE2_VERSION=10.49
ARG PCRE2_URL="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$PCRE2_VERSION/pcre2-$PCRE2_VERSION.tar.bz2"
ARG PCRE2_FILE="pcre2.$PCRE2_VERSION.tar.bz2"
ARG PCRE2_SHA256=53c156e1ba416a20da8e65395daa132da0d80e76910424caca3fcdae7831d384
RUN \
  tar $TAR_OPTS $PCRE2_FILE && \
  cd pcre2-* && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static \
    --enable-jit && \
  make -j$(nproc) install

# bump: libffi /LIBFFI_VERSION=([\d.]+)/ https://github.com/libffi/libffi.git|^3
# bump: libffi after ./hashupdate Dockerfile LIBFFI $LATEST
# bump: libffi link "Release notes" https://github.com/libffi/libffi/releases/tag/v$LATEST
ARG LIBFFI_VERSION=3.5.2
ARG LIBFFI_URL="https://github.com/libffi/libffi/releases/download/v$LIBFFI_VERSION/libffi-$LIBFFI_VERSION.tar.gz"
ARG LIBFFI_FILE="libffi.$LIBFFI_VERSION.tar.gz"
ARG LIBFFI_SHA256=f3a3082a23b37c293a4fcd1053147b371f2ff91fa7ea1b2a52e335676bac82dc
ARG LIBFFI_FIX_TESTS_FORTIFY_URL="$APORTS_RAW/libffi/fix-tests-fortify.patch"
ARG LIBFFI_FIX_TESTS_FORTIFY_FILE="libffi.fix-tests-fortify.patch"
ARG LIBFFI_FIX_TESTS_FORTIFY_SHA256=3b4481a269c79b8e8d89bb5b4c85db622691680d7230361e37f1ee842bbcbe8f
RUN \
  tar $TAR_OPTS $LIBFFI_FILE && \
  cd libffi-* && \
  patch -p1 < ../$LIBFFI_FIX_TESTS_FORTIFY_FILE && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static \
    --disable-docs \
    --enable-pax_emutramp \
    --enable-portable-binary \
    --disable-exec-static-tramp && \
  make -j$(nproc) install

# bump: pixman /PIXMAN_VERSION=([\d.]+)/ https://gitlab.freedesktop.org/pixman/pixman.git|/^pixman-\d+\.\d+\.\d+$/|re:#^pixman-(.*)$#${1}#|*
# bump: pixman after ./hashupdate Dockerfile PIXMAN $LATEST
# bump: pixman link "Release notes" https://gitlab.freedesktop.org/pixman/pixman/-/tags/pixman-$LATEST
ARG PIXMAN_VERSION=0.46.4
ARG PIXMAN_URL="https://xorg.freedesktop.org/releases/individual/lib/pixman-$PIXMAN_VERSION.tar.xz"
ARG PIXMAN_FILE="pixman.$PIXMAN_VERSION.tar.xz"
ARG PIXMAN_SHA256=a098c33924754ad43f981b740f6d576c70f9ed1006e12221b1845431ebce1239
RUN \
  tar $TAR_OPTS $PIXMAN_FILE && \
  cd pixman-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dlibpng=enabled \
    -Ddemos=disabled \
    -Dtests=disabled && \
  ninja -j$(nproc) -vC build install

# no enable-fips: the fips provider is a module that only dlopen() can load
# bump: openssl /OPENSSL_VERSION=([\d.]+)/ https://github.com/openssl/openssl.git|/^openssl-3\.5\.\d+$/|re:#^openssl-(.*)$#${1}#|*
# bump: openssl after ./hashupdate Dockerfile OPENSSL $LATEST
# bump: openssl link "CHANGES" https://github.com/openssl/openssl/blob/openssl-3.5/CHANGES.md
ARG OPENSSL_VERSION=3.5.9
ARG OPENSSL_URL="https://github.com/openssl/openssl/releases/download/openssl-$OPENSSL_VERSION/openssl-$OPENSSL_VERSION.tar.gz"
ARG OPENSSL_FILE="openssl.$OPENSSL_VERSION.tar.gz"
ARG OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
ARG OPENSSL_AUXV_URL="$APORTS_RAW/openssl/auxv.patch"
ARG OPENSSL_AUXV_FILE="openssl.auxv.patch"
ARG OPENSSL_AUXV_SHA256=0b3a36c0f1b3d8e0adcf02c251374ce4d2578b0c9f4b88207bf85c5c1b58c7d8
RUN \
  tar $TAR_OPTS $OPENSSL_FILE && \
  cd openssl-* && \
  patch -p1 < ../$OPENSSL_AUXV_FILE && \
  perl ./Configure \
    linux-$(uname -m) \
    $(if [ $(uname -m) == x86_64 ]; then echo enable-ec_nistp_64_gcc_128; fi) \
    --prefix=/usr/local \
    --libdir=lib \
    --openssldir=/etc/ssl \
    enable-ktls \
    no-shared \
    no-zlib \
    no-async \
    no-comp \
    no-idea \
    no-mdc2 \
    no-rc5 \
    no-ec2m \
    no-ssl3 \
    no-seed \
    no-weak-ssl-ciphers \
    no-tests \
    no-docs \
    -Wa,--noexecstack && \
  make -j$(nproc) build_libs && \
  make install_dev

# bump: numactl /NUMACTL_VERSION=([\d.]+)/ https://github.com/numactl/numactl.git|^2
# bump: numactl after ./hashupdate Dockerfile NUMACTL $LATEST
# bump: numactl link "Release notes" https://github.com/numactl/numactl/releases/tag/v$LATEST
ARG NUMACTL_VERSION=2.0.19
ARG NUMACTL_URL="https://github.com/numactl/numactl/releases/download/v$NUMACTL_VERSION/numactl-$NUMACTL_VERSION.tar.gz"
ARG NUMACTL_FILE="numactl.$NUMACTL_VERSION.tar.gz"
ARG NUMACTL_SHA256=f2672a0381cb59196e9c246bf8bcc43d5568bc457700a697f1a1df762b9af884
RUN \
  tar $TAR_OPTS $NUMACTL_FILE && \
  cd numactl-* && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static && \
  make -j$(nproc) libnuma.la && \
  make install-libLTLIBRARIES install-includeHEADERS install-pkgconfigDATA

# double precision only, the one rubberband uses
# bump: fftw /FFTW_VERSION=([\d.]+)/ fetch:https://www.fftw.org/download.html|/fftw-([\d.]+)\.tar\.gz/
# bump: fftw after ./hashupdate Dockerfile FFTW $LATEST
# bump: fftw link "NEWS" https://www.fftw.org/release-notes.html
ARG FFTW_VERSION=3.3.11
ARG FFTW_URL="http://www.fftw.org/fftw-$FFTW_VERSION.tar.gz"
ARG FFTW_FILE="fftw.$FFTW_VERSION.tar.gz"
ARG FFTW_SHA256=5630c24cdeb33b131612f7eb4b1a9934234754f9f388ff8617458d0be6f239a1
ARG FFTW_CYCLE_H_URL="$APORTS_RAW/fftw/cycle.h.patch"
ARG FFTW_CYCLE_H_FILE="fftw.cycle.h.patch"
ARG FFTW_CYCLE_H_SHA256=f3a4c8f01024f7474c69aa229c0046eea78d357281fcf0d9146fce839fd03e7c
RUN \
  tar $TAR_OPTS $FFTW_FILE && \
  cd fftw-* && \
  patch -p1 < ../$FFTW_CYCLE_H_FILE && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static \
    --disable-fortran \
    --disable-doc \
    $(if [ $(uname -m) == x86_64 ]; then echo --enable-sse2 --enable-avx; fi) && \
  make -j$(nproc) install

# bump: libsamplerate /LIBSAMPLERATE_VERSION=([\d.]+)/ https://github.com/libsndfile/libsamplerate.git|^0
# bump: libsamplerate after ./hashupdate Dockerfile LIBSAMPLERATE $LATEST
# bump: libsamplerate link "NEWS" https://github.com/libsndfile/libsamplerate/blob/master/NEWS
ARG LIBSAMPLERATE_VERSION=0.2.2
ARG LIBSAMPLERATE_URL="https://github.com/libsndfile/libsamplerate/releases/download/$LIBSAMPLERATE_VERSION/libsamplerate-$LIBSAMPLERATE_VERSION.tar.xz"
ARG LIBSAMPLERATE_FILE="libsamplerate.$LIBSAMPLERATE_VERSION.tar.xz"
ARG LIBSAMPLERATE_SHA256=3258da280511d24b49d6b08615bbe824d0cacc9842b0e4caf11c52cf2b043893
RUN \
  tar $TAR_OPTS $LIBSAMPLERATE_FILE && \
  cd libsamplerate-* && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static && \
  make -j$(nproc) src/libsamplerate.la && \
  make install-libLTLIBRARIES install-includeHEADERS install-pkgconfigDATA

# bump: soxr /SOXR_VERSION=([\d.]+)/ fetch:https://sourceforge.net/projects/soxr/files/|/soxr-([\d.]+)-Source\.tar\.xz/
# bump: soxr after ./hashupdate Dockerfile SOXR $LATEST
# bump: soxr link "NEWS" https://sourceforge.net/p/soxr/code/ci/master/tree/NEWS
ARG SOXR_VERSION=0.1.3
ARG SOXR_URL="https://sourceforge.net/projects/soxr/files/soxr-$SOXR_VERSION-Source.tar.xz/download"
ARG SOXR_FILE="soxr.$SOXR_VERSION.tar.xz"
ARG SOXR_SHA256=b111c15fdc8c029989330ff559184198c161100a59312f5dc19ddeb9b5a15889
RUN \
  tar $TAR_OPTS $SOXR_FILE && \
  cd soxr-* && \
  cmake -B build \
    -G"Unix Makefiles" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_TESTS=OFF \
    -DWITH_LSR_BINDINGS=OFF && \
  make -C build -j$(nproc) install

# bump: vo-amrwbenc /VO_AMRWBENC_VERSION=([\d.]+)/ fetch:https://sourceforge.net/projects/opencore-amr/files/vo-amrwbenc/|/vo-amrwbenc-([\d.]+)\.tar\.gz/
# bump: vo-amrwbenc after ./hashupdate Dockerfile VO_AMRWBENC $LATEST
ARG VO_AMRWBENC_VERSION=0.1.3
ARG VO_AMRWBENC_URL="https://downloads.sourceforge.net/opencore-amr/vo-amrwbenc/vo-amrwbenc-$VO_AMRWBENC_VERSION.tar.gz"
ARG VO_AMRWBENC_FILE="vo-amrwbenc.$VO_AMRWBENC_VERSION.tar.gz"
ARG VO_AMRWBENC_SHA256=5652b391e0f0e296417b841b02987d3fd33e6c0af342c69542cbb016a71d9d4e
RUN \
  tar $TAR_OPTS $VO_AMRWBENC_FILE && \
  cd vo-amrwbenc-* && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static && \
  make -j$(nproc) install

# bump: snappy /SNAPPY_VERSION=([\d.]+)/ https://github.com/google/snappy.git|^1
# bump: snappy after ./hashupdate Dockerfile SNAPPY $LATEST
# bump: snappy link "NEWS" https://github.com/google/snappy/blob/main/NEWS
ARG SNAPPY_VERSION=1.2.2
ARG SNAPPY_URL="https://github.com/google/snappy/archive/$SNAPPY_VERSION.tar.gz"
ARG SNAPPY_FILE="snappy.$SNAPPY_VERSION.tar.gz"
ARG SNAPPY_SHA256=90f74bc1fbf78a6c56b3c4a082a05103b3a56bb17bca1a27e052ea11723292dc
ARG SNAPPY_CMAKELISTS_URL="$APORTS_RAW/snappy/cmakelists.patch"
ARG SNAPPY_CMAKELISTS_FILE="snappy.cmakelists.patch"
ARG SNAPPY_CMAKELISTS_SHA256=938e83b00b6a61eb131578520588af5fedaa911e7493f17870b1c1e56b286dcc
ARG SNAPPY_NO_INCLUDE_GTEST_URL="$APORTS_RAW/snappy/no-include-gtest.patch"
ARG SNAPPY_NO_INCLUDE_GTEST_FILE="snappy.no-include-gtest.patch"
ARG SNAPPY_NO_INCLUDE_GTEST_SHA256=9a360343b8222f688e20af265aa74bd5e5effd6ad8d2a2794bedf6801e534eec
ARG SNAPPY_RTTI_URL="$APORTS_RAW/snappy/rtti.patch"
ARG SNAPPY_RTTI_FILE="snappy.rtti.patch"
ARG SNAPPY_RTTI_SHA256=36eec3821376c2bc3a19198ef6f31a7aa5be23b0501cbfd17b1c8f2c1ff6b5ca
RUN \
  tar $TAR_OPTS $SNAPPY_FILE && \
  cd snappy-* && \
  for p in $SNAPPY_CMAKELISTS_FILE $SNAPPY_NO_INCLUDE_GTEST_FILE $SNAPPY_RTTI_FILE; do patch -p1 < ../$p || exit 1; done && \
  # the cmakelists patch defines the static target only next to the shared one; the shared library goes so -lsnappy links statically
  cmake -B build \
    -G"Unix Makefiles" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_STATIC_LIBS=ON \
    -DSNAPPY_BUILD_TESTS=OFF \
    -DSNAPPY_BUILD_BENCHMARKS=OFF && \
  make -C build -j$(nproc) install && \
  rm /usr/local/lib/libsnappy.so*

# before aom as libvmaf uses it
# bump: vmaf /VMAF_VERSION=([\d.]+)/ https://github.com/Netflix/vmaf.git|*
# bump: vmaf after ./hashupdate Dockerfile VMAF $LATEST
# bump: vmaf link "Release" https://github.com/Netflix/vmaf/releases/tag/v$LATEST
# bump: vmaf link "Source diff $CURRENT..$LATEST" https://github.com/Netflix/vmaf/compare/v$CURRENT..v$LATEST
ARG VMAF_VERSION=3.2.1
ARG VMAF_URL="https://github.com/Netflix/vmaf/archive/refs/tags/v$VMAF_VERSION.tar.gz"
ARG VMAF_FILE="vmaf.$VMAF_VERSION.tar.gz"
ARG VMAF_SHA256=5df7386911bc15fd1ca783132528748d219768ae4fc5f8e0b61184f041648092
RUN \
  tar $TAR_OPTS $VMAF_FILE && \
  cd vmaf-*/libvmaf && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dbuilt_in_models=true \
    -Denable_tests=false \
    -Denable_docs=false \
    -Denable_tools=false \
    -Denable_avx512=true \
    -Denable_float=true && \
  ninja -j$(nproc) -vC build install
# extra libs stdc++ is for vmaf https://github.com/Netflix/vmaf/issues/788
RUN sed -i 's/-lvmaf /-lvmaf -lstdc++ /' /usr/local/lib/pkgconfig/libvmaf.pc

# own build as alpine glib links with libmount etc
# bump: glib /GLIB_VERSION=([\d.]+)/ https://gitlab.gnome.org/GNOME/glib.git|^2
# bump: glib after ./hashupdate Dockerfile GLIB $LATEST
# bump: glib link "NEWS" https://gitlab.gnome.org/GNOME/glib/-/blob/main/NEWS?ref_type=heads
ARG GLIB_VERSION=2.90.1
ARG GLIB_URL="https://download.gnome.org/sources/glib/${GLIB_VERSION%.*}/glib-$GLIB_VERSION.tar.xz"
ARG GLIB_FILE="glib.$GLIB_VERSION.tar.xz"
ARG GLIB_SHA256=93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396
RUN \
  tar $TAR_OPTS $GLIB_FILE && \
  cd glib-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dtests=false \
    -Dsysprof=disabled \
    -Dglib_debug=disabled \
    -Dlibmount=disabled && \
  # only the targets with the install tags devel and bin-devel: libraries, headers, .pc files and build tools
  ninja -j$(nproc) -vC build $(jq -r --arg b "$PWD/build/" '.targets | to_entries[] | select(.value.tag == "devel" or .value.tag == "bin-devel") | .key | ltrimstr($b)' build/meson-info/intro-install_plan.json) && \
  meson install -C build --no-rebuild --tags devel,bin-devel
# exported symbols keep rust thread locals as unresolved relocations that a static pie never applies
RUN sed -i 's/-Wl,--export-dynamic//' /usr/local/lib/pkgconfig/gmodule-2.0.pc /usr/local/lib/pkgconfig/gmodule-export-2.0.pc

# bump: harfbuzz /LIBHARFBUZZ_VERSION=([\d.]+)/ https://github.com/harfbuzz/harfbuzz.git|*
# bump: harfbuzz after ./hashupdate Dockerfile LIBHARFBUZZ $LATEST
# bump: harfbuzz link "NEWS" https://github.com/harfbuzz/harfbuzz/blob/main/NEWS
ARG LIBHARFBUZZ_VERSION=14.6.0
ARG LIBHARFBUZZ_URL="https://github.com/harfbuzz/harfbuzz/releases/download/$LIBHARFBUZZ_VERSION/harfbuzz-$LIBHARFBUZZ_VERSION.tar.xz"
ARG LIBHARFBUZZ_FILE="libharfbuzz.$LIBHARFBUZZ_VERSION.tar.xz"
ARG LIBHARFBUZZ_SHA256=d07a007327277708a2a73ae437887cdbaf282937f6d03ca5467723e9099af586
RUN \
  tar $TAR_OPTS $LIBHARFBUZZ_FILE && \
  cd harfbuzz-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dgobject=disabled \
    -Dsubset=disabled \
    -Draster=disabled \
    -Dvector=disabled \
    -Dgpu=disabled \
    -Dtests=disabled \
    -Dutilities=disabled && \
  ninja -j$(nproc) -vC build install

# bump: cairo /CAIRO_VERSION=([\d.]+)/ https://gitlab.freedesktop.org/cairo/cairo.git|^1
# bump: cairo after ./hashupdate Dockerfile CAIRO $LATEST
# bump: cairo link "NEWS" https://gitlab.freedesktop.org/cairo/cairo/-/blob/master/NEWS?ref_type=heads
ARG CAIRO_VERSION=1.18.6
ARG CAIRO_URL="https://gitlab.freedesktop.org/cairo/cairo/-/archive/$CAIRO_VERSION/cairo-$CAIRO_VERSION.tar.gz"
ARG CAIRO_FILE="cairo.$CAIRO_VERSION.tar.gz"
ARG CAIRO_SHA256=a95ae4f522ef24312af7339563f65e0a03b1ad3d58a46df73d2ef690fe15ae7f
RUN \
  tar $TAR_OPTS $CAIRO_FILE && \
  cd cairo-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dtests=disabled \
    -Dprefer_static=true \
    -Dtee=disabled \
    -Dquartz=disabled \
    -Dxcb=disabled \
    -Dxlib=disabled \
    -Dxlib-xcb=disabled && \
  ninja -j$(nproc) -vC build $(jq -r --arg b "$PWD/build/" '.targets | to_entries[] | select(.value.tag == "devel" or .value.tag == "bin-devel") | .key | ltrimstr($b)' build/meson-info/intro-install_plan.json) && \
  meson install -C build --no-rebuild --tags devel,bin-devel

# TODO: there is weird "1.90" tag, skip it
# bump: pango /PANGO_VERSION=([\d.]+)/ https://github.com/GNOME/pango.git|/\d+\.\d+\.\d+/|*
# bump: pango after ./hashupdate Dockerfile PANGO $LATEST
# bump: pango link "NEWS" https://gitlab.gnome.org/GNOME/pango/-/blob/main/NEWS?ref_type=heads
ARG PANGO_VERSION=1.58.2
ARG PANGO_URL="https://download.gnome.org/sources/pango/${PANGO_VERSION%.*}/pango-$PANGO_VERSION.tar.xz"
ARG PANGO_FILE="pango.$PANGO_VERSION.tar.xz"
ARG PANGO_SHA256=342385b6ca3b7c73455d7c80a13b7dbe4489e00bc3bd4c5bd6ed4dce421e374a
RUN \
  tar $TAR_OPTS $PANGO_FILE && \
  cd pango-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dprefer_static=true \
    -Dintrospection=disabled \
    -Dbuild-testsuite=false \
    -Dbuild-examples=false \
    -Dgtk_doc=false && \
  ninja -j$(nproc) -vC build $(jq -r --arg b "$PWD/build/" '.targets | to_entries[] | select(.value.tag == "devel" or .value.tag == "bin-devel") | .key | ltrimstr($b)' build/meson-info/intro-install_plan.json) && \
  meson install -C build --no-rebuild --tags devel,bin-devel

# bump: librsvg /LIBRSVG_VERSION=([\d.]+)/ https://gitlab.gnome.org/GNOME/librsvg.git|^2
# bump: librsvg after ./hashupdate Dockerfile LIBRSVG $LATEST
# bump: librsvg link "NEWS" https://gitlab.gnome.org/GNOME/librsvg/-/blob/master/NEWS
ARG LIBRSVG_VERSION=2.63.3
ARG LIBRSVG_URL="https://download.gnome.org/sources/librsvg/${LIBRSVG_VERSION%.*}/librsvg-$LIBRSVG_VERSION.tar.xz"
ARG LIBRSVG_FILE="librsvg.$LIBRSVG_VERSION.tar.xz"
ARG LIBRSVG_SHA256=55311c2293612e4a2e38cd9bdb6160a1c85c158adc7c97e423e1e65949afb6a4
RUN \
  tar $TAR_OPTS $LIBRSVG_FILE && \
  cd librsvg-* && \
  export CFLAGS="${CFLAGS% $LTO_FLAGS}" && \
  # workaround for https://gitlab.gnome.org/GNOME/librsvg/-/issues/1158
  sed -i "/^if host_system in \['windows'/s/, 'linux'//" meson.build && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Ddocs=disabled \
    -Dintrospection=disabled \
    -Dpixbuf=disabled \
    -Dpixbuf-loader=disabled \
    -Dvala=disabled \
    -Drsvg-convert=disabled \
    -Dtests=false && \
  ninja -j$(nproc) -vC build install

# build after libvmaf
# bump: aom /AOM_VERSION=([\d.]+)/ fetch:https://storage.googleapis.com/aom-releases/|/libaom-([\d.]+)\.tar\.gz/|*
# bump: aom after ./hashupdate Dockerfile AOM $LATEST
# bump: aom link "CHANGELOG" https://aomedia.googlesource.com/aom/+/refs/tags/v$LATEST/CHANGELOG
ARG AOM_VERSION=3.15.2
ARG AOM_URL="https://storage.googleapis.com/aom-releases/libaom-$AOM_VERSION.tar.gz"
ARG AOM_FILE="aom.$AOM_VERSION.tar.gz"
ARG AOM_SHA256=67bb54b245f33ed98600e08269e6139986e48114e14042474ddd8885801dfddc
RUN \
  tar $TAR_OPTS $AOM_FILE && \
  cd libaom-* && \
  mkdir build_tmp && \
  cd build_tmp && \
  cmake \
    -G"Unix Makefiles" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DENABLE_APPS=NO \
    -DENABLE_EXAMPLES=NO \
    -DENABLE_DOCS=NO \
    -DENABLE_TESTS=NO \
    -DENABLE_TOOLS=NO \
    -DCONFIG_TUNE_VMAF=1 \
    -DCONFIG_LIBYUV=0 \
    -DENABLE_NASM=ON \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_SKIP_INSTALL_ALL_DEPENDENCY=ON \
    .. && \
  make -j$(nproc) aom aom_pc && \
  make install

# bump: libaribb24 /LIBARIBB24_VERSION=([\d.]+)/ https://github.com/nkoriyama/aribb24.git|*
# bump: libaribb24 after ./hashupdate Dockerfile LIBARIBB24 $LATEST
# bump: libaribb24 link "Release notes" https://github.com/nkoriyama/aribb24/releases/tag/$LATEST
ARG LIBARIBB24_VERSION=1.0.3
ARG LIBARIBB24_URL="https://github.com/nkoriyama/aribb24/archive/v$LIBARIBB24_VERSION.tar.gz"
ARG LIBARIBB24_FILE="libaribb24.$LIBARIBB24_VERSION.tar.gz"
ARG LIBARIBB24_SHA256=f61560738926e57f9173510389634d8c06cabedfa857db4b28fb7704707ff128
RUN \
  mkdir libaribb24 && \
  tar $TAR_OPTS $LIBARIBB24_FILE -C libaribb24 --strip-components=1 && \
  cd libaribb24 && \
  autoreconf -fiv && \
  ./configure \
    --disable-dependency-tracking \
    --enable-static \
    --disable-shared && \
  make -j$(nproc) && make install

# bump: libass /LIBASS_VERSION=([\d.]+)/ https://github.com/libass/libass.git|*
# bump: libass after ./hashupdate Dockerfile LIBASS $LATEST
# bump: libass link "Release notes" https://github.com/libass/libass/releases/tag/$LATEST
ARG LIBASS_VERSION=0.17.5
ARG LIBASS_URL="https://github.com/libass/libass/releases/download/$LIBASS_VERSION/libass-$LIBASS_VERSION.tar.gz"
ARG LIBASS_FILE="libass.$LIBASS_VERSION.tar.gz"
ARG LIBASS_SHA256=caab4b993dd7be6187c55623b789ed75dddefea6e65938af134637c732fe094a
RUN \
  tar $TAR_OPTS $LIBASS_FILE && \
  cd libass-* && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static && \
  make -j$(nproc) && make install

# bump: libudfread /LIBUDFREAD_VERSION=([\d.]+)/ fetch:https://download.videolan.org/pub/videolan/libudfread/|/libudfread-([\d.]+)\.tar\.xz/|*
# bump: libudfread after ./hashupdate Dockerfile LIBUDFREAD $LATEST
# bump: libudfread link "Source diff $CURRENT..$LATEST" https://code.videolan.org/videolan/libudfread/-/compare/$CURRENT...$LATEST
ARG LIBUDFREAD_VERSION=1.2.0
ARG LIBUDFREAD_URL="https://download.videolan.org/pub/videolan/libudfread/libudfread-$LIBUDFREAD_VERSION.tar.xz"
ARG LIBUDFREAD_FILE="libudfread.$LIBUDFREAD_VERSION.tar.xz"
ARG LIBUDFREAD_SHA256=bb477cbd4cfbfc7787d9d05b71ee5e70430f5cfebf1297497f7e83547958050f
RUN \
  tar $TAR_OPTS $LIBUDFREAD_FILE && \
  cd libudfread-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static && \
  ninja -j$(nproc) -vC build install

# bump: libbluray /LIBBLURAY_VERSION=([\d.]+)/ fetch:https://download.videolan.org/pub/videolan/libbluray/last/|/libbluray-([\d.]+)\.tar\.xz/
# bump: libbluray after ./hashupdate Dockerfile LIBBLURAY $LATEST
# bump: libbluray link "ChangeLog" https://code.videolan.org/videolan/libbluray/-/blob/master/ChangeLog
ARG LIBBLURAY_VERSION=1.5.0
ARG LIBBLURAY_URL="https://download.videolan.org/pub/videolan/libbluray/$LIBBLURAY_VERSION/libbluray-$LIBBLURAY_VERSION.tar.xz"
ARG LIBBLURAY_FILE="libbluray.$LIBBLURAY_VERSION.tar.xz"
ARG LIBBLURAY_SHA256=f676408e91a5d321abf8b8d4dfdae36205c297dab5c54c3ec519639025f474a2
RUN \
  tar $TAR_OPTS $LIBBLURAY_FILE && \
  cd libbluray-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Denable_tools=false \
    -Dfreetype=disabled && \
  ninja -j$(nproc) -vC build install

# bump: dav1d /DAV1D_VERSION=([\d.]+)/ fetch:https://download.videolan.org/pub/videolan/dav1d/last/|/dav1d-([\d.]+)\.tar\.xz/
# bump: dav1d after ./hashupdate Dockerfile DAV1D $LATEST
# bump: dav1d link "Release notes" https://code.videolan.org/videolan/dav1d/-/tags/$LATEST
ARG DAV1D_VERSION=1.5.4
ARG DAV1D_URL="https://download.videolan.org/pub/videolan/dav1d/$DAV1D_VERSION/dav1d-$DAV1D_VERSION.tar.xz"
ARG DAV1D_FILE="dav1d.$DAV1D_VERSION.tar.xz"
ARG DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5
RUN \
  tar $TAR_OPTS $DAV1D_FILE && \
  cd dav1d-* && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Denable_tools=false \
    -Denable_tests=false && \
  ninja -j$(nproc) -vC build install

# bump: davs2 /DAVS2_VERSION=([\d.]+)/ https://github.com/pkuvcl/davs2.git|^1
# bump: davs2 after ./hashupdate Dockerfile DAVS2 $LATEST
# bump: davs2 link "Release" https://github.com/pkuvcl/davs2/releases/tag/$LATEST
# bump: davs2 link "Source diff $CURRENT..$LATEST" https://github.com/pkuvcl/davs2/compare/v$CURRENT..v$LATEST
ARG DAVS2_VERSION=1.7
ARG DAVS2_URL="https://github.com/pkuvcl/davs2/archive/refs/tags/$DAVS2_VERSION.tar.gz"
ARG DAVS2_FILE="davs2.$DAVS2_VERSION.tar.gz"
ARG DAVS2_SHA256=b697d0b376a1c7f7eda3a4cc6d29707c8154c4774358303653f0a9727f923cc8
# TODO: seems to be issues with asm on musl
RUN \
  tar $TAR_OPTS $DAVS2_FILE && \
  cd davs2-*/build/linux && \
  # the endian test of configure reads strings from an object file, the lto flag comes from --enable-lto
  CFLAGS="${CFLAGS% $LTO_FLAGS}" \
  ./configure \
    --enable-lto \
    --disable-asm \
    --enable-pic \
    --enable-strip \
    --disable-cli && \
  make -j$(nproc) install

# bump: fdk-aac /FDK_AAC_VERSION=([\d.]+)/ https://github.com/mstorsjo/fdk-aac.git|*
# bump: fdk-aac after ./hashupdate Dockerfile FDK_AAC $LATEST
# bump: fdk-aac link "ChangeLog" https://github.com/mstorsjo/fdk-aac/blob/master/ChangeLog
# bump: fdk-aac link "Source diff $CURRENT..$LATEST" https://github.com/mstorsjo/fdk-aac/compare/v$CURRENT..v$LATEST
ARG FDK_AAC_VERSION=3.0.0
ARG FDK_AAC_URL="https://github.com/mstorsjo/fdk-aac/archive/v$FDK_AAC_VERSION.tar.gz"
ARG FDK_AAC_FILE="fdk-aac.$FDK_AAC_VERSION.tar.gz"
ARG FDK_AAC_SHA256=8538ea8f0f9915e460c106a13e1866a9e13c7ee48c1b67d0b2cf7b4e8159bd1a
ARG ENABLE_FDKAAC=
RUN \
  if [[ -n "$ENABLE_FDKAAC" ]]; then \
  tar $TAR_OPTS $FDK_AAC_FILE && \
  cd fdk-aac-* && \
  ./autogen.sh && \
  ./configure \
    --disable-dependency-tracking \
    --disable-shared \
    --enable-static && \
  make -j$(nproc) install; \
  fi

# bump: libgme /LIBGME_VERSION=([\d.]+)/ https://github.com/libgme/game-music-emu.git|*
# bump: libgme after ./hashupdate Dockerfile LIBGME $LATEST
# bump: libgme link "Source diff $CURRENT..$LATEST" https://github.com/libgme/game-music-emu/compare/$CURRENT..$LATEST
ARG LIBGME_VERSION=0.6.5
ARG LIBGME_URL="https://github.com/libgme/game-music-emu/releases/download/$LIBGME_VERSION/libgme-$LIBGME_VERSION-src.tar.gz"
ARG LIBGME_FILE="libgme.$LIBGME_VERSION.tar.gz"
ARG LIBGME_SHA256=a133f19278222136ba0d8c27b64a07987ba05fec9d2e6d293ccd8cabdd97ddbb
RUN \
  tar $TAR_OPTS $LIBGME_FILE && \
  cd libgme-* && \
  mkdir build && \
  cd build && \
  cmake \
    -G"Unix Makefiles" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DENABLE_UBSAN=OFF \
    .. && \
  make -j$(nproc) install

# bump: libgsm /LIBGSM_VERSION=([\d.]+)/ fetch:https://www.quut.com/gsm/|/gsm-([\d.]+)\.tar\.gz/
# bump: libgsm after ./hashupdate Dockerfile LIBGSM $LATEST
# bump: libgsm link "Homepage" https://www.quut.com/gsm/
ARG LIBGSM_VERSION=1.0.24
ARG LIBGSM_URL="https://www.quut.com/gsm/gsm-$LIBGSM_VERSION.tar.gz"
ARG LIBGSM_FILE="libgsm.$LIBGSM_VERSION.tar.gz"
ARG LIBGSM_SHA256=a3c40c6471928383f4abfcb2e8f24012a1f562be2f17b8d672145d5986681a92
RUN \
  tar $TAR_OPTS $LIBGSM_FILE && \
  cd gsm-* && \
  # Makefile is hard to use, hence use specific compile arguments and flags
  # no need to build toast cli tool \
  rm src/toast* && \
  SRC=$(echo src/*.c) && \
  gcc ${CFLAGS} -c -ansi -pedantic -s -DNeedFunctionPrototypes=1 -Wall -Wno-comment -DSASR -DWAV49 -DNDEBUG -I./inc ${SRC} && \
  ar cr libgsm.a *.o && ranlib libgsm.a && \
  mkdir -p /usr/local/include/gsm && \
  cp inc/*.h /usr/local/include/gsm && \
  cp libgsm.a /usr/local/lib

# bump: kvazaar /KVAZAAR_VERSION=([\d.]+)/ https://github.com/ultravideo/kvazaar.git|^2
